# 请求
string date_from    # 起始日期，空串表示不限
string date_to      # 结束日期，空串表示不限
string node_filter  # 节点名包含的字符串，空串表示不限
uint32 limit        # 返回最大条数
uint32 offset       # 偏移量
---
# 返回项结构体
string[] paths      # 相对路径，供删除或下载使用
string[] nodes      # 节点名
string[] dates      # 日期
uint64[] sizes      # 文件大小字节
uint64[] mtimes     # 修改时间戳（秒）
